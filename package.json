  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "dotenv": "^17.4.2",
    "expo": "~57.0.18",
    "expo-constants": "^57.0.16",
    "expo-keep-awake": "^57.0.1",
    "expo-linking": "^57.0.8",
    "expo-location": "^57.0.14",
    "expo-router": "^57.0.17",
    "expo-sqlite": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "^57.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "0.86.3",
    "react-native-amap3d": "^3.2.4",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/supercluster": "^7.1.3",
